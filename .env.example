# Generate a long random value, for example: openssl rand -hex 32
WEBGLOW_API_TOKEN=replace-this-with-a-long-random-token

# Keep this only as a recovery secret for the portal's username/password login.
# Generate separately, for example: openssl rand -hex 32
WEBGLOW_PASSWORD_RESET_TOKEN=replace-this-with-a-different-long-random-token

# The host and container port used by the WebGlow portal.
WEBGLOW_PORT=1828

# Optional: restrict browser-based API clients to one origin instead of *.
# WEBGLOW_CORS_ORIGIN=https://controller.example.com

# Used by compose.portainer.yaml after the GitHub Action has published an image.
WEBGLOW_IMAGE=ghcr.io/jerielsr/webglow
WEBGLOW_IMAGE_TAG=latest
