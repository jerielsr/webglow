# Generate a long random value, for example: openssl rand -hex 32
WEBGLOW_API_TOKEN=replace-this-with-a-long-random-token

# Keep this only as a recovery secret for the portal's username/password login.
# Generate separately, for example: openssl rand -hex 32
WEBGLOW_PASSWORD_RESET_TOKEN=replace-this-with-a-different-long-random-token

# The host and container port used by the WebGlow portal.
WEBGLOW_PORT=1828

# HTTPS is available alongside HTTP. The local certificate authority is generated on first run.
WEBGLOW_HTTPS_ENABLED=true
# The HTTPS port inside the container; leave this at its default unless you know the container's binding constraints.
WEBGLOW_HTTPS_PORT=18443
# Optional host-facing port. Set to 443 if the host has that port free and WEBGLOW_PUBLIC_URL uses https://domain.
WEBGLOW_HTTPS_HOST_PORT=18443

# Optional: set the URL that should appear in guest QR codes and display links.
# Include the HTTPS port unless a trusted HTTPS proxy maps the hostname to WebGlow.
# WEBGLOW_PUBLIC_URL=https://192.168.1.20:18443

# Optional: add the hostname(s) or IP address(es) used by guest devices to the generated certificate.
# The values are comma- or space-separated and must not include a scheme or port.
# WEBGLOW_TLS_HOSTS=lights.example.org,192.168.1.20

# Optional custom certificate. Mount the host folder containing these PEM files into the container at /certs.
# A custom certificate must cover the hostnames/IP addresses used in WEBGLOW_PUBLIC_URL.
# WEBGLOW_TLS_CERT_FILE=/certs/fullchain.pem
# WEBGLOW_TLS_KEY_FILE=/certs/privkey.pem

# Optional: restrict browser-based API clients to one origin instead of *.
# WEBGLOW_CORS_ORIGIN=https://controller.example.com

# Used by compose.portainer.yaml after the GitHub Action has published an image.
WEBGLOW_IMAGE=ghcr.io/jerielsr/webglow
WEBGLOW_IMAGE_TAG=latest
